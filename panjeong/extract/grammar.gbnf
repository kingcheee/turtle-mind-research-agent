root ::= "{" ws "\"doc_type\"" ws ":" ws doctype "," ws "\"category\"" ws ":" ws cat "," ws "\"amount_total\"" ws ":" ws numornull "," ws "\"vat_included\"" ws ":" ws boolornull "," ws "\"date\"" ws ":" ws dateornull "," ws "\"time\"" ws ":" ws timeornull "," ws "\"vendor_name\"" ws ":" ws stringornull "," ws "\"vendor_type\"" ws ":" ws vtype "," ws "\"has_alcohol\"" ws ":" ws boolornull "," ws "\"attendee_count\"" ws ":" ws numornull "," ws "\"attendees\"" ws ":" ws attendees "," ws "\"purpose\"" ws ":" ws stringornull "," ws "\"trip\"" ws ":" ws trip ws "}"
doctype ::= "\"영수증\"" | "\"회의록\"" | "\"출장신청서\"" | "\"출장결과보고서\"" | "\"기타\""
cat ::= "\"회의비\"" | "\"출장비\"" | "\"불명\""
vtype ::= "\"식당\"" | "\"카페\"" | "\"주점\"" | "\"호텔\"" | "\"교통\"" | "\"숙박\"" | "\"기타\"" | "null"
attendees ::= "[" ws "]" | "[" ws att (ws "," ws att)* ws "]"
att ::= "{" ws "\"name\"" ws ":" ws string "," ws "\"affiliation\"" ws ":" ws stringornull "," ws "\"external\"" ws ":" ws boolornull ws "}"
trip ::= "null" | "{" ws "\"destination\"" ws ":" ws stringornull "," ws "\"start\"" ws ":" ws dateornull "," ws "\"end\"" ws ":" ws dateornull "," ws "\"domestic\"" ws ":" ws boolornull "," ws "\"meals_provided\"" ws ":" ws boolornull ws "}"
boolornull ::= "true" | "false" | "null"
numornull ::= number | "null"
number ::= "-"? [0-9]+ ("." [0-9]+)?
dateornull ::= date | "null"
date ::= "\"" [0-9] [0-9] [0-9] [0-9] "-" [0-9] [0-9] "-" [0-9] [0-9] "\""
timeornull ::= time | "null"
time ::= "\"" [0-9] [0-9] ":" [0-9] [0-9] "\""
stringornull ::= string | "null"
string ::= "\"" char* "\""
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
ws ::= [ \t\n]*
